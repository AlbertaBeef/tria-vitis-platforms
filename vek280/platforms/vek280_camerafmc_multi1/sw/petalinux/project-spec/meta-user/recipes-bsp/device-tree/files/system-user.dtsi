	xlnx,video-width = <10>;
	xlnx,cfa-pattern = "rggb";
};

&isppipeline_port1mipi_1_ISPPipeline_accel_0 {
	//xlnx,video-format = <3>; // XVIP_VF_YUV_420
	//xlnx,video-format = <2>; // XVIP_VF_RBG
	xlnx,video-format = <21>; // XVIP_VF_XRGB
	xlnx,video-width = <8>;
	xlnx,cfa-pattern = "rggb";
};

&mipi_3_ISPPipeline_accel_0 {
	rreset-gpios = <&cips_ss_0_axi_gpio_1 12 1>;
	xlnx,max-height = /bits/ 16 <4096>;
	xlnx,max-width = /bits/ 16 <4096>;
	xlnx,rgain = /bits/ 16 <128>;
	xlnx,bgain = /bits/ 16 <210>;
	xlnx,pawb = /bits/ 16 <350>;
