//#include "include/dt-bindings/media/xilinx-vip.h"
/include/ "system-conf.dtsi"
/ {
	chosen {
		bootargs = "console=ttyAMA0  earlycon=pl011,mmio32,0xFF000000,115200n8 clk_ignore_unused root=/dev/mmcblk1p2 rw rootwait";
		stdout-path = "serial0:115200n8";
	};

	memorynoc_ddr4: memory@0 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x80000000>, <0x8 0x00000000 0x0 0x80000000>;
	};

	memorynoc_lpddr4: memory@50000000000 {
		device_type = "memory";
		reg = <0x00000500 0x00000000 0x00000002 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		video_reserved: cap_buf@0 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x0 0x0 0x80000000>;
			reusable;
		};

		reserved: buffer@0 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x500 0x0 0x2 0x0>;
			linux,cma-default;
		};
	};
};

//#include "i2c0_mux_conf.dtsi"

&amba_pl {
	imx219_clk: imx219_clk {
		#clock-cells = <0x0>;
		clock-frequency = <24000000>;
		compatible = "fixed-clock";
	};


	imx219_vana: fixedregulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "imx219_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		enable-active-high;
	};

	imx219_vdig: fixedregulator@4 {
		compatible = "regulator-fixed";
		regulator-name = "imx219_vdig";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	imx219_vddl: fixedregulator@5 {
		compatible = "regulator-fixed";
		regulator-name = "imx219_vddl";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};		

};

&i2c0 {
	status = "okay";
	i2c-mux@70 {
		compatible = "nxp,pca9548";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x70>;

		i2c@0 { /* SFP0 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};
		i2c@1 { /* SFP1 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};
		i2c@2 { /* MIPI4 - RPI-CAM2 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;

		};
		i2c@3 { /* MIPI3 - RPI-CAM1 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			imx219_cam1: sensor@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				clocks = <&imx219_clk>;

				VANA-supply = <&imx219_vana>;   /* 2.8v */
				VDIG-supply = <&imx219_vdig>;   /* 1.8v */
				VDDL-supply = <&imx219_vddl>;   /* 1.2v */
		
				rotation = <180>;
				orientation = <2>;

				port {
				     imx219_cam1_0: endpoint {
				        clock-lanes = <0>;
					data-lanes = <1 2>;
					clock-noncontinuous;
					link-frequencies = /bits/ 64 <456000000>;		     
			
					remote-endpoint = <&mipi_csi_inmipi_1_csirx_0>;
					};
				};
			};
		};
		i2c@4 { /* MIPI2 - RPI-CAM0 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <4>;
			imx219_cam0: sensor@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				clocks = <&imx219_clk>;

				VANA-supply = <&imx219_vana>;   /* 2.8v */
				VDIG-supply = <&imx219_vdig>;   /* 1.8v */
				VDDL-supply = <&imx219_vddl>;   /* 1.2v */
		
				rotation = <180>;
				orientation = <2>;

				port {
				     imx219_cam0_0: endpoint {
				        clock-lanes = <0>;
					data-lanes = <1 2>;
					clock-noncontinuous;
					link-frequencies = /bits/ 64 <456000000>;		     
			
					remote-endpoint = <&mipi_csi_inmipi_0_csirx_0>;
					};
				};
			};
		};
		i2c@5 { /* MIPI5 - RPI-CAM3 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <5>;
		};
		i2c@6 { /* MIPI0 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <6>;
		};
		i2c@7 { /* MIPI1 */
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <7>;
		};
	};
};


&mipi_0_csirx_0 {
	xlnx,en-active-lanes;
};

&mipi_1_csirx_0 {
	xlnx,en-active-lanes;
};


&mipi_csi_inmipi_0_csirx_0 {
	remote-endpoint = <&imx219_cam0_0>;
};

&mipi_csi_inmipi_1_csirx_0 {
	remote-endpoint = <&imx219_cam1_0>;
};

&mipi_0_ISPPipeline_accel_0 {
	//reset-gpios = <&cips_ss_0_axi_gpio_1 0 1>;
	xlnx,max-height = /bits/ 16 <4096>;
	xlnx,max-width = /bits/ 16 <4096>;
	xlnx,rgain = /bits/ 16 <128>;
	xlnx,bgain = /bits/ 16 <210>;
	xlnx,pawb = /bits/ 16 <350>;
	xlnx,mode-reg = <1>;
};

&isppipeline_port0mipi_0_ISPPipeline_accel_0 {
	xlnx,video-format = <12>; // XVIP_VF_MONO_SENSOR
	xlnx,video-width = <10>;
	xlnx,cfa-pattern = "rggb";
};

&isppipeline_port1mipi_0_ISPPipeline_accel_0 {
	//xlnx,video-format = <3>; // XVIP_VF_YUV_420
	//xlnx,video-format = <2>; // XVIP_VF_RBG
	xlnx,video-format = <21>; // XVIP_VF_XRGB
	xlnx,video-width = <8>;
	xlnx,cfa-pattern = "rggb";
};

&mipi_1_ISPPipeline_accel_0 {
	//reset-gpios = <&cips_ss_0_axi_gpio_1 4 1>;
	xlnx,max-height = /bits/ 16 <4096>;
	xlnx,max-width = /bits/ 16 <4096>;
	xlnx,rgain = /bits/ 16 <128>;
	xlnx,bgain = /bits/ 16 <210>;
	xlnx,pawb = /bits/ 16 <350>;
	xlnx,mode-reg = <1>;
};

&isppipeline_port0mipi_1_ISPPipeline_accel_0 {
	xlnx,video-format = <12>; // XVIP_VF_MONO_SENSOR
	xlnx,video-width = <10>;
	xlnx,cfa-pattern = "rggb";
};

&isppipeline_port1mipi_1_ISPPipeline_accel_0 {
	//xlnx,video-format = <3>; // XVIP_VF_YUV_420
	//xlnx,video-format = <2>; // XVIP_VF_RBG
	xlnx,video-format = <21>; // XVIP_VF_XRGB
	xlnx,video-width = <8>;
	xlnx,cfa-pattern = "rggb";
};

&mipi_0_v_proc_csc {
	compatible = "xlnx,v-vpss-scaler-2.2";
};
